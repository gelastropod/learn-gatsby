export default "#version 300 es\r\nprecision mediump float;\r\n\r\nuniform float u_time;\r\nuniform vec2 u_resolution;\r\n\r\nin vec2 aPos;\r\n\r\nout vec4 fragColor;\r\n\r\nfloat sMin(float a, float b, float k)\r\n{\r\n  float h = clamp(0.5 + 0.5 * (a - b) / k, 0.0, 1.0);\r\n  return mix(a, b, h) - k * h * (1.0 - h);\r\n}\r\n\r\nfloat dist(vec3 position)\r\n{\r\n    float k = 0.2 * (sin(u_time * 0.35) + 1.0);\r\n    float z = sin(u_time) + 2.5;\r\n    return sMin(length(position - vec3(0.0, 0.0, z)) - 1.0, position.y + 0.5, k);\r\n}\r\n\r\nvoid main()\r\n{\r\n    vec2 uv = vec2(aPos.x, aPos.y * u_resolution.y / u_resolution.x);\r\n    \r\n    vec3 ray = vec3(uv, 1.0);\r\n    vec3 cray = vec3(0.0, 0.0, 0.0);\r\n    float td = 0.0;\r\n    \r\n    int i;\r\n    \r\n    for (i = 0; i < 80; i++)\r\n    {\r\n        float d = dist(cray);\r\n        td += d;\r\n        cray = ray * td;\r\n        \r\n        if (td > 100.0 || d < 0.001) break;\r\n    }\r\n    \r\n    td /= 3.0;\r\n    \r\n    fragColor = vec4(td, td, td, 0.0);\r\n}";